# Database
# Docker: DB_HOST=mysql, DB_PORT=3306 (service name inside Docker network)
# Local PHP: DB_HOST=127.0.0.1, DB_PORT=3307 (if using Docker MySQL) or 3306 (native MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cow_tracker
DB_USER=root
DB_PASSWORD=secret

# App
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_DEBUG=false

# Logging (debug | info | warning | error) — written as JSON lines to STDOUT
LOG_LEVEL=info

# Mail
# driver: log = writes to storage/mail.log | smtp = SMTP server | mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Cow Tracker

# Set to true to queue emails instead of sending them during the HTTP request.
# The worker (bin/mail-worker.php) must be running to deliver them.
MAIL_ASYNC=false

# SMTP settings (required when MAIL_DRIVER=smtp)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
