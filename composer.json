{
    "name": "example/cow-tracker",
    "description": "Simple PHP 8.1 app that tracks user activity (no framework).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": "php bin/setup.php",
        "serve": "php -S localhost:8000 -t public public/index.php",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true
    }
}
